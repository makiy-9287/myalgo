# ══════════════════════════════════════════════════════════════════
#  BINANCE FUTURES SIGNAL ENGINE — configuration
#  Copy this file to `.env` and fill it in.  NEVER commit `.env`.
#
#  This build is SIGNAL-ONLY. It reads public Binance market data and
#  sends Telegram messages. There is no Binance API key because there
#  is no order placement — the code that could lose money does not
#  exist in this project.
# ══════════════════════════════════════════════════════════════════

# ─── TELEGRAM (the only credentials needed) ───────────────────────
# Token from @BotFather ; chat id from @userinfobot
TELEGRAM_BOT_TOKEN=8893521930:AAHh4kFLjh_PWLWzkCcu8OepukqKOJVWipw
TELEGRAM_CHAT_ID=5530953384
# Extra user ids allowed to issue commands (comma separated, optional)
TELEGRAM_ADMIN_IDS=

# ─── UNIVERSE ─────────────────────────────────────────────────────
MIN_VOLUME_USDT=10000000       # 10M USDT 24h quote volume
MAX_SYMBOLS=220                # hard cap to protect the rate limit
QUOTE_ASSET=USDT
SYMBOL_BLACKLIST=              # e.g. USDCUSDT,BTCDOMUSDT

# ─── TIMING (seconds) ─────────────────────────────────────────────
ANALYSIS_INTERVAL=300           # deep analysis cycle (5 minutes)
UNIVERSE_REFRESH_INTERVAL=10800 # rebuild the coin list (3 hours)
TRACKER_INTERVAL=15            # entry-fill / TP / SL polling
TELEGRAM_POLL_TIMEOUT=25

# ─── NETWORK ──────────────────────────────────────────────────────
HTTP_CONCURRENCY=12
HTTP_TIMEOUT=20

# ─── LOGGING ──────────────────────────────────────────────────────
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# ══════════════════════════════════════════════════════════════════
#  Everything else — modes, strategies, minimum score, RR, alerts,
#  close/reopen rules — is adjusted live from Telegram via /settings and
#  persists in data/runtime_config.json. You do not edit it here.
# ══════════════════════════════════════════════════════════════════
